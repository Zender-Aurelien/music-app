# Copy this file to .env and fill in real values. .env is gitignored.

# Jamendo API client id (https://devportal.jamendo.com/)
CLIENT_ID=

# SQLite database location, relative to the instance/ folder.
# Leave as-is unless you have a reason to change it.
DATABASE_URL=sqlite:///app.db

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Google OAuth 2.0 credentials (Google Cloud Console -> APIs & Services ->
# Credentials -> Create OAuth client ID -> Web application).
# Authorized redirect URI must be exactly: http://localhost:5000/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where to redirect the browser after a successful login (the Vite dev server).
FRONTEND_URL=http://localhost:5173
